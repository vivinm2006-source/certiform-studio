# CertiForm Studio Environment Configuration

# Application
PROJECT_NAME="CertiForm Studio"
VERSION="1.0.0"

# Public Verification Base URL (used in generated QR codes & verification links)
PUBLIC_BASE_URL="http://localhost:5173"

# Database Configuration
# Local SQLite:
DATABASE_URL="sqlite:///certiform.db"
# Production PostgreSQL:
# DATABASE_URL="postgresql://user:password@localhost:5432/certiform"

# Document Rendering Engine
DEFAULT_DPI=300
PREVIEW_DPI=150
